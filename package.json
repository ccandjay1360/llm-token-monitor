{
  "name": "token-monitor",
  "productName": "Token Monitor",
  "description": "跨中转站 Token 用量监控与桌面挂件",
  "author": "cc",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/index.js",
    "dev:all": "concurrently -n web,api -c blue,green \"vite\" \"node server/index.js\"",
    "dev:desktop": "concurrently -k -n web,api,widget -c blue,green,magenta \"vite\" \"node server/index.js\" \"set NODE_ENV=development&& electron .\"",
    "desktop": "electron .",
    "build": "vite build",
    "preview": "vite preview",
    "test:server": "node --test server/usage-date.test.mjs server/cache-metrics.test.mjs server/refresh-cache.test.mjs server/browser-session.test.mjs server/browser-lock.test.mjs server/api-auth.test.mjs server/providers.test.mjs server/json-store.test.mjs server/config.test.mjs server/aggregate.test.mjs server/history.test.mjs electron/api-server-runtime.test.cjs",
    "package:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "lucide-react": "^0.400.0",
    "playwright": "^1.62.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1",
    "recharts": "^2.12.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.cc.tokenmonitor",
    "asar": true,
    "publish": null,
    "electronDist": "node_modules/electron/dist",
    "icon": "build/icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json",
      "!.playwright/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*",
      "!node_modules/@electron/**/*",
      "!node_modules/@vitejs/**/*",
      "!node_modules/vite/**/*",
      "!node_modules/concurrently/**/*",
      "!node_modules/esbuild/**/*",
      "!node_modules/@esbuild/**/*",
      "!server/**/*.test.mjs",
      "!electron/**/*.test.cjs",
      "!server/config.json",
      "!server/cache.json",
      "!server/history.json",
      "!server/auth/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
